{
  "manifest_version": 3,
  "name": "CoffeeBean - Instant Coffee TAS",
  "version": "0.9.8",
  "description": "Instant Coffee frame control with deterministic Godot PCG32 TAS replay.",
  "action": {
    "default_title": "CoffeeBean TAS",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["coffee-main.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["test/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "minimum_chrome_version": "102"
}
